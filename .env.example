# Talkback configuration. Copy to `.env` (gitignored) and fill in.
#
# REQUIRED: this is the only thing you need to run Talkback locally.
# Get a key from your Boson AI workspace. It powers read-aloud audio (Higgs TTS 3), Talkback voice
# conversations (Higgs Realtime), faces (Higgs Avatar) and voice cloning. It stays on the server; the browser
# only ever gets short-lived keys. Set a monthly spend cap in the Boson workspace first.
BOSON_API_KEY=

# --- Everything below is OPTIONAL. Leave it commented out to run with Boson only. ---

# Boson API endpoint (this is the default).
# BOSON_BASE_URL=https://api.boson.ai

# Full upload processing (main characters, dialogue voices, recap) and Gemini-written typed answers WITHOUT any key of
# your own: the author runs a small processing service. It is used only when you have no ANTHROPIC_API_KEY and no
# Google Cloud credentials. If it is closed or over its free limit, uploads fall back to simple local processing
# and typed answers go through Boson Realtime. Sample books are already fully processed and never use it.
# Your book text is sent to it only while a book is being processed; spoiler filtering stays on your machine.
# Clear the value to turn it off.
PUBLIC_API_URL=https://talkback-public-272822965835.us-central1.run.app

# Anthropic key: better character/dialogue/recap processing when you upload your own novel.
# Without it (and without Google Cloud) an upload is read by the narrator, with characters found by a simple
# name-based fallback, and the app says so.
# ANTHROPIC_API_KEY=

# Which model processes uploaded novels (gemini|claude, default gemini). Claude needs ANTHROPIC_API_KEY and falls back
# to Gemini if it is unusable.
# UPLOAD_LLM=gemini
# Same switch for the offline preprocess/ scripts (default gemini).
# LLM_PROVIDER=gemini
# Testing mode: show a cost estimate and wait for confirmation before processing an uploaded novel.
# UPLOAD_CONFIRM=false

# Google Cloud: Gemini answers and Vertex AI Vector Search instead of the local BM25 search + Boson Realtime answers.
# Needs `gcloud auth application-default login` and your OWN project/bucket (replace the placeholders).
# RETRIEVAL_BACKEND=vertex          # default is "local": no Google Cloud needed
# GCP_PROJECT=your-gcp-project-id
# GCP_REGION=us-central1
# Gemini answers may search the web (Grounding with Google Search) for textbooks and for novels with spoilers on,
# never for a novel read spoiler-safe. Grounded answers are capped per UTC day (past Vertex's free tier each costs ~$0.035).
# WEB_SEARCH=true
# GROUNDED_DAILY_CAP=100
# GCP_BUCKET=your-gcp-bucket-name

# For a public deployment only: voices then need an access code typed into the page.
# TALKBACK_ACCESS_TOKEN=

# Append billable calls to data/cache/usage.jsonl (default true).
# USAGE_LOG_FILE=true
# Lip-sync output size: 640x640 ($0.09/min, default), 480x640 or 640x480 ($0.07/min). The size is part of the clip cache key.
# AVATAR_SIZE=640x640

# Live faces (optional): Boson's preset avatars (Claire, Emma, James) rendered live into a LiveKit Cloud room, in sync
# with the voice. Needs a LiveKit Cloud project (the free tier works). Without these, faces use per-sentence clips.
# LIVEKIT_URL=wss://<your-project>.livekit.cloud
# LIVEKIT_API_KEY=
# LIVEKIT_API_SECRET=
