BOSON_API_KEY=
ANTHROPIC_API_KEY=
BOSON_BASE_URL=https://api.boson.ai
GCP_PROJECT=frederick-talkback
GCP_REGION=us-central1
GCP_BUCKET=frederick-talkback-data
RETRIEVAL_BACKEND=local
# Uploaded novels: which LLM writes cast/dialogue/summaries (claude|gemini). Claude falls back to Gemini when out of credit.
UPLOAD_LLM=claude
# Same switch for the offline preprocess/ scripts (claude|gemini).
LLM_PROVIDER=claude
# Testing mode: show a cost estimate and wait for confirmation before processing an uploaded novel.
UPLOAD_CONFIRM=false
